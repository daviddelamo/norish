# The Obscura build Norish ships.
#
# Obscura is the headless browser that renders pages for URL imports. Norish
# repackages it into its own image rather than pulling upstream's, because
# upstream's Dockerfile compiles `--features render` only — the runtime
# `--stealth` flag alone gets half a feature (see README.md next to this file).
# Upstream's *release archives* do ship a stealth build, and that is what this
# image takes.
#
# This file is the single record of what the image contains: the upstream
# release, the commit it was cut from, the SHA-256 of each architecture's
# archive, and the immutable tag it was published under. The checksums are what
# make the pin real — GitHub release assets can be replaced in place, so the
# tag alone would not be enough.
#
# Bump these together, publish, then update the tag in every compose surface —
# the release workflows run `verify-pin.sh`, which refuses to ship a Norish
# release whose examples reference a tag that is not published or does not
# match this pin.
#
# Shell-sourceable on purpose: `set -a; . docker/obscura/pin.env; set +a`.

OBSCURA_REPO=https://github.com/h4ckf0r0day/obscura
OBSCURA_VERSION=0.2.0
# The commit `v0.2.0` was cut from. The binaries come from the release, not from
# a build of this tree; it is recorded so a release can name its browser source.
OBSCURA_REVISION=97124edeb2ea610615e78f43e097454e3b221f6b

# sha256 of obscura-<arch>-linux-stealth.tar.gz from the v0.2.0 release.
OBSCURA_SHA256_AMD64=4b0fe0ff32a2e17e33b1e3d67bfb06e8f4d875bdffa86aa766277232422dfde7
OBSCURA_SHA256_ARM64=d9b55448043815872d6fdc9d51aca7efd4055abff41fe3dd3fb512718c746bee

OBSCURA_IMAGE=docker.io/norishapp/obscura
# `<upstream version>-norish.<build>`: the build counter moves when the image
# changes without the upstream release moving (a Dockerfile or base-image fix).
OBSCURA_IMAGE_TAG=0.2.0-norish.1
