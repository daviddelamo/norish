# The Obscura build Norish ships.
#
# Obscura is the headless browser that renders pages for URL imports. Norish
# builds and publishes its own image rather than pulling upstream's, because
# upstream's Dockerfile omits the `stealth` cargo feature — the runtime
# `--stealth` flag alone only gets half of it (see README.md next to this file).
#
# This file is the single record of what that image contains: the upstream
# source revision and the immutable tag it was published under. Bump both
# together, publish, then update the tag in every compose surface — the release
# workflows run `verify-pin.sh`, which refuses to ship a Norish release whose
# examples reference a tag that is not published or does not match this pin.
#
# Shell-sourceable on purpose: `set -a; . docker/obscura/pin.env; set +a`.

OBSCURA_REPO=https://github.com/h4ckf0r0day/obscura.git
OBSCURA_VERSION=0.2.0
OBSCURA_REVISION=97124edeb2ea610615e78f43e097454e3b221f6b

OBSCURA_IMAGE=docker.io/norishapp/obscura
# `<upstream version>-norish.<build>`: the build counter moves when the image
# changes without the upstream source moving (a Dockerfile or toolchain fix).
OBSCURA_IMAGE_TAG=0.2.0-norish.1
